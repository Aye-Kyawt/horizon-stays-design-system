{
  "name": "@aye_kyawt/horizon-stays-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tokens": "node build-tokens.js",
    "build:lib": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "build:package": "npm run build:tokens && npm run build:lib && npm run build:css",
    "prepublishOnly": "npm run build:package && npm test",
    "release:publish": "node scripts/release-publish.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "registry:init": "node scripts/registry-init.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "style-dictionary": "^5.5.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
